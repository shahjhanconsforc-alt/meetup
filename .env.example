# Copy to .env and fill in. Every value here is read in backend/config.py and
# nowhere else (MinIO's are read in services/storage/minio_client.py, which loads
# this same file so it also works when run as a standalone script).

# ─── Server ────────────────────────────────────────────────────────
HOST=127.0.0.1
# 4200, not 4000/4100: the Instagram bot owns 4000 and the Threads bot 4100 on
# the machine these run side by side on. Two servers cannot share a port.
PORT=4200
ENV=development

# ─── Meetup account (the default profile's login) ──────────────────
MU_USERNAME=
MU_PASSWORD=

# ─── Playwright ────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_CHANNEL=chrome
PLAYWRIGHT_SLOWMO=0
PLAYWRIGHT_CLEAN_LAUNCH=true
PLAYWRIGHT_START_URL=
# Keep Chromium's --no-sandbox (needed when running as root, e.g. in Docker,
# where docker-compose.yml already sets it). Leave false on a desktop.
PLAYWRIGHT_NO_SANDBOX=false

# ─── Docker on an Ubuntu Desktop VM ────────────────────────────────
# host = the browser opens on the VM's own desktop (DISPLAY, usually :0)
# headless = no window at all (also set PLAYWRIGHT_HEADLESS=true)
DISPLAY_MODE=host
DISPLAY=:0
TZ=UTC

# ─── Proxy (optional) ──────────────────────────────────────────────
# One proxy, kept for the whole session — Meetup treats an IP change on a
# logged-in session as a suspicious login, so we deliberately do NOT rotate.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_BYPASS=localhost,127.0.0.1

# ─── MinIO ─────────────────────────────────────────────────────────
MINIO_URL=localhost:9000
MINIO_USER=
MINIO_PASSWORD=
# S3 bucket names may not contain underscores — hence the "meetup-" prefix.
MINIO_BUCKET=meetup-members
MINIO_BUCKET_SESSIONS=meetup-sessions
MINIO_BUCKET_MEDIA=meetup-media
MINIO_BUCKET_MESSAGES=meetup-messages
